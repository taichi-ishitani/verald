/// A simple bus: a request is accepted at an edge where `valid` and `ready`
/// are both high; a read's data comes back at the next edge, with `rvalid`.
interface bus_if {
    var valid : logic    ;
    var ready : logic    ;
    var write : logic    ;
    var addr  : logic<3> ;
    var wdata : logic<16>;
    var rvalid: logic    ;
    var rdata : logic<16>;

    modport master {
        valid : output,
        ready : input ,
        write : output,
        addr  : output,
        wdata : output,
        rvalid: input ,
        rdata : input ,
    }

    modport slave {
        valid : input ,
        ready : output,
        write : input ,
        addr  : input ,
        wdata : input ,
        rvalid: output,
        rdata : output,
    }

    modport monitor {
        valid : input,
        ready : input,
        write : input,
        addr  : input,
        wdata : input,
        rvalid: input,
        rdata : input,
    }
}

/// Eight 16-bit registers on the bus. `ready` drops one cycle in three.
module regblock (
    i_clk: input   clock         ,
    i_rst: input   reset         ,
    bus  : modport bus_if::slave ,
) {
    var regs : logic<16> [8];
    var count: logic<2>     ;

    assign bus.ready = count != 2;

    always_ff {
        if_reset {
            for i in 0..8 {
                regs[i] = 0;
            }
            count      = 0;
            bus.rvalid = 0;
            bus.rdata  = 0;
        } else {
            count      = if count == 2 ? 0 : count + 1;
            bus.rvalid = bus.valid && bus.ready && !bus.write;
            if bus.valid && bus.ready {
                if bus.write {
                    regs[bus.addr] = bus.wdata;
                } else {
                    bus.rdata = regs[bus.addr];
                }
            }
        }
    }
}

/// Runs a test of the testbench against the register block, with the bus's
/// assertions (`BusAssertions`) bound at the registered names. The test, the
/// options and the test's values are given at run time, as runtime
/// arguments:
///
///     veryl +local test --runtime-arg=VERALD_TESTNAME:ReverseTest --runtime-arg=ROUNDS:4
///
/// `BasicTest` runs when none is named, for 2 rounds.
#[test(regblock_test)]
module regblock_test {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);
    inst bus: bus_if;
    inst dut: regblock (
        i_clk: clk       ,
        i_rst: rst       ,
        bus  : bus.slave ,
    );
    inst tb : $comp::verald_regblock;

    initial {
        tb.set_clock("clk", clk);
        tb.set_reset("rst", rst);
        tb.set_modport("bus", bus.master);
        tb.set_modport("bus_mon", bus.monitor);
        tb.bind_to_instance("", "BusAssertions");
        tb.start("BasicTest");
        clk.start();
        rst.assert(clk);
    }
}

/// Checks the register block with the bus's assertions alone, no
/// testbench: the test module drives the bus itself, writing every register
/// and reading each back, a request held until `ready`.
#[test(regblock_assertions_test)]
module regblock_assertions_test {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);
    inst bus: bus_if;
    inst dut: regblock (
        i_clk: clk       ,
        i_rst: rst       ,
        bus  : bus.slave ,
    );
    inst checks: $comp::verald_regblock_assertions;

    // The requests made so far: writes to registers 0 to 7, then reads.
    var count: logic<5>;

    always_ff (clk, rst) {
        if_reset {
            count     = 0;
            bus.valid = 0;
            bus.write = 0;
            bus.addr  = 0;
            bus.wdata = 0;
        } else if !bus.valid || bus.ready {
            if count == 16 {
                bus.valid = 0;
            } else {
                bus.valid = 1;
                bus.write = count <: 8;
                bus.addr  = count[2:0];
                bus.wdata = 16'h0100 + count;
                count     = count + 1;
            }
        }
    }

    initial {
        checks.set_clock("clk", clk);
        checks.set_reset("rst", rst);
        checks.set_modport("bus_mon", bus.monitor);
        checks.bind_to_instance("", "BusAssertions");
        checks.start();
        rst.assert(clk);
        clk.next(40);
        $finish();
    }
}
