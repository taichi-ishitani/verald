/// Checks how Veryl's simulator calls the testbench's hooks around a reset:
/// `on_reset` at every edge in reset, no `on_clock` meanwhile, and the
/// release seen at the first `on_clock` after it.
#[test(hooks_test)]
module hooks_test {
    inst clk: $tb::clock_gen;
    inst rst: $tb::reset_gen (clk);
    inst tb : $comp::verald_hooks;

    initial {
        tb.set_clock("clk", clk);
        tb.set_reset("rst", rst);
        tb.option("timeout", 100);
        tb.start("hooks");
        clk.start();
        rst.assert(clk);
    }
}
